# Copy to .env and fill in. Never commit .env.

# Source registry. Local default is SQLite; production uses Postgres (e.g. Neon free tier):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=sqlite:///data/registry.db

# Vector database. Leave QDRANT_URL empty to use local on-disk Qdrant at QDRANT_PATH.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Active chunking strategy for the app: "fixed" or "sentence"
CHUNK_STRATEGY=sentence

# LLM provider: "gemini", "groq" or "fake" (offline, for tests and demos without a key)
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
